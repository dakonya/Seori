<!-- Lab-scoped rules. Install on a disposable Wazuh manager.
     Native parents: 554 added, 550 modified, 553 deleted.
     Wazuh decoded FIM field 'file' becomes 'syscheck.path' in alerts.
     These rules verify monitoring of this lab path; they do not claim attack attribution. -->
<group name="syscheck,detectionci,">
  <rule id="100200" level="5">
    <if_sid>554</if_sid>
    <field name="file" type="pcre2">^/var/lib/detectionci/watch/</field>
    <description>Seori lab: monitored file created.</description>
    <group>syscheck_entry_added,</group>
  </rule>
  <rule id="100201" level="5">
    <if_sid>550</if_sid>
    <field name="file" type="pcre2">^/var/lib/detectionci/watch/</field>
    <description>Seori lab: monitored file modified.</description>
    <group>syscheck_entry_modified,</group>
  </rule>
  <rule id="100202" level="5">
    <if_sid>553</if_sid>
    <field name="file" type="pcre2">^/var/lib/detectionci/watch/</field>
    <description>Seori lab: monitored file deleted.</description>
    <group>syscheck_entry_deleted,</group>
  </rule>
</group>
